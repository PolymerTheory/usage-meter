<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The sync URL + bearer token must not land in Google cloud
     backup. A direct device-to-device transfer keeps them so a new phone stays
     paired; appearance settings travel either way. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="usage_widget_prefs.xml" />
        <exclude domain="file" path="last_usage.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="last_usage.json" />
    </device-transfer>
</data-extraction-rules>
